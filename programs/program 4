
#include <stdio.h>

#define INF 10000000
#define N 4

int main() {
    int a[N][N] = {
        {0,   5, INF, 10},
        {INF, 0,   3, INF},
        {INF, INF, 0,   1},
        {INF, INF, INF, 0}
    };

    int i, j, k;

    printf("Initial Matrix:\n");
    for (i = 0; i < N; i++) {
        for (j = 0; j < N; j++) {
            if (a[i][j] == INF)
                printf("INF ");
            else
                printf("%d ", a[i][j]);
        }
        printf("\n");
    }

    for (k = 0; k < N; k++) {
        for (i = 0; i < N; i++) {
            for (j = 0; j < N; j++) {
                if (a[i][k] != INF && a[k][j] != INF &&
                    a[i][k] + a[k][j] < a[i][j]) {
                    a[i][j] = a[i][k] + a[k][j];
                }
            }
        }
    }

    printf("\nFinal Distance Matrix:\n");
    for (i = 0; i < N; i++) {
        for (j = 0; j < N; j++) {
            if (a[i][j] == INF)
                printf("INF ");
            else
                printf("%d ", a[i][j]);
        }
        printf("\n");
    }

    return 0;
}
