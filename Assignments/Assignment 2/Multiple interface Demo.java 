interface Camera {
    void takePhoto();
}

interface Music {
    void playMusic();
}

class Mobile implements Camera, Music {

    public void takePhoto() {
        System.out.println("Mobile takes photo");
    }

    public void playMusic() {
        System.out.println("Mobile plays music");
    }
}

public class MultipleInterface {
    public static void main(String[] args) {

        Mobile m = new Mobile();

        m.takePhoto();
        m.playMusic();
    }
}