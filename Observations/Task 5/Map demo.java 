import java.util.HashMap;
import java.util.Map;

public class MapExample {
    public static void main(String[] args) {

        Map<String, Integer> busRoutes = new HashMap<>();

        busRoutes.put("Vijayawada-Guntur", 101);
        busRoutes.put("Vijayawada-Hyderabad", 205);
        busRoutes.put("Vijayawada-Vizag", 310);
        busRoutes.put("Guntur-Tirupati", 415);

        System.out.println("Bus Routes: " + busRoutes);

        // Accessing value using key
        System.out.println("Bus for Vijayawada-Vizag: "
                + busRoutes.get("Vijayawada-Vizag"));

        // Removing an entry
        busRoutes.remove("Guntur-Tirupati");

        System.out.println("After Removal: " + busRoutes);
    }
}