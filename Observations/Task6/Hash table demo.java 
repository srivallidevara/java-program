import java.util.Hashtable;

public class HashtableExample {
    public static void main(String[] args) {

        Hashtable<String, String> contacts = new Hashtable<>();

        // Adding contacts
        contacts.put("Ambulance", "108");
        contacts.put("Police", "100");
        contacts.put("Fire Service", "101");
        contacts.put("Women Helpline", "181");

        System.out.println("Emergency Contacts: " + contacts);

        // Getting phone number
        System.out.println("Ambulance Number: "
                + contacts.get("Ambulance"));

        // Checking a contact
        System.out.println("Is Police Number Available? "
                + contacts.containsKey("Police"));

        // Removing a contact
        contacts.remove("Fire Service");

        System.out.println("After Removal: " + contacts);
    }
}