import java.util.HashSet;

public class HashSetExample {
    public static void main(String[] args) {

        HashSet<Integer> platforms = new HashSet<>();

        platforms.add(2);
        platforms.add(5);
        platforms.add(1);
        platforms.add(3);
        platforms.add(2);

        System.out.println("Platform Numbers: " + platforms);

        // Checking a platform
        System.out.println("Is Platform 5 available? "
                + platforms.contains(5));

        // Removing a platform
        platforms.remove(3);

        System.out.println("After Removal: " + platforms);

        System.out.println("Total Platforms: "
                + platforms.size());
    }
}