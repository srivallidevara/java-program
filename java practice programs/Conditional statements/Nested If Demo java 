public class VotingSystem {
    public static void main(String[] args) {
        int age = 20;
        boolean hasVoterId = false;

        // Outer if: Checks age eligibility
        if (age >= 18) {
            System.out.println("You are an adult.");

            // Inner if: Checks document availability
            if (hasVoterId) {
                System.out.println("You are eligible to vote!");
            } else {
                System.out.println("You are eligible, but please apply for a Voter ID card first.");
            }
        } else {
            System.out.println("You are a minor. Not eligible to vote.");
        }
    }
}
